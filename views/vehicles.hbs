<h1>Vehicles</h1>

<p>Browse, add, update, and delete luxury rental vehicles.</p>

<h2>Browse Vehicles</h2>
<table>
    <thead>
        <tr>
            <th>vehicleID</th>
            <th>location</th>
            <th>make</th>
            <th>model</th>
            <th>year</th>
            <th>licensePlate</th>
            <th>dailyRate</th>
            <th>status</th>
            <th>mileage</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        {{#each vehicles}}
        <tr>
            <td>{{this.vehicleID}}</td>
            <td>{{this.locationName}}</td>
            <td>{{this.make}}</td>
            <td>{{this.model}}</td>
            <td>{{this.year}}</td>
            <td>{{this.licensePlate}}</td>
            <td>{{this.dailyRate}}</td>
            <td>{{this.status}}</td>
            <td>{{this.mileage}}</td>
            <td><button>Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>

<h2>Add Vehicle</h2>
<form>
    <label>Location:</label>
    <select name="locationID" required>
        <option value="">Select a Location</option>
        <option value="1">Beverly Hills</option>
        <option value="2">Newport Beach</option>
        <option value="3">Irvine</option>
    </select>

    <label>Make:</label>
    <input type="text" name="make" required>

    <label>Model:</label>
    <input type="text" name="model" required>

    <label>Year:</label>
    <input type="number" name="year" required>

    <label>License Plate:</label>
    <input type="text" name="licensePlate" required>

    <label>Daily Rate:</label>
    <input type="number" step="0.01" name="dailyRate" required>

    <label>Status:</label>
    <select name="status">
        <option value="Available">Available</option>
        <option value="Rented">Rented</option>
        <option value="Maintenance">Maintenance</option>
    </select>

    <label>Mileage:</label>
    <input type="number" name="mileage">

    <input type="submit" value="Add Vehicle">
</form>

<h2>Update Vehicle</h2>
<form>
    <label>Vehicle to Update:</label>
    <select name="vehicleID" required>
        <option value="">Select a Vehicle</option>
        <option value="1">1 - Ferrari 488 Spider</option>
        <option value="2">2 - Lamborghini Huracan</option>
        <option value="3">3 - Rolls Royce Ghost</option>
    </select>

    <label>New Location:</label>
    <select name="locationID">
        <option value="">Select a Location</option>
        <option value="1">Beverly Hills</option>
        <option value="2">Newport Beach</option>
        <option value="3">Irvine</option>
    </select>

    <label>New Make:</label>
    <input type="text" name="make">

    <label>New Model:</label>
    <input type="text" name="model">

    <label>New Year:</label>
    <input type="number" name="year">

    <label>New License Plate:</label>
    <input type="text" name="licensePlate">

    <label>New Daily Rate:</label>
    <input type="number" step="0.01" name="dailyRate">

    <label>New Status:</label>
    <select name="status">
        <option value="">Select Status</option>
        <option value="Available">Available</option>
        <option value="Rented">Rented</option>
        <option value="Maintenance">Maintenance</option>
    </select>

    <label>New Mileage:</label>
    <input type="number" name="mileage">

    <input type="submit" value="Update Vehicle">
</form>
