<h1>Clients</h1>

<p>Browse, add, update, and delete client records.</p>

<h2>Browse Clients</h2>
<table>
    <thead>
        <tr>
            <th>clientID</th>
            <th>firstName</th>
            <th>lastName</th>
            <th>email</th>
            <th>phone</th>
            <th>membershipTier</th>
            <th>joinDate</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        {{#each clients}}
        <tr>
            <td>{{this.clientID}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.email}}</td>
            <td>{{this.phone}}</td>
            <td>{{this.membershipTier}}</td>
            <td>{{this.joinDate}}</td>
            <td><button>Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>

<h2>Add Client</h2>
<form>
    <label>First Name:</label>
    <input type="text" name="firstName" required>

    <label>Last Name:</label>
    <input type="text" name="lastName" required>

    <label>Email:</label>
    <input type="email" name="email" required>

    <label>Phone:</label>
    <input type="text" name="phone" required>

    <label>Membership Tier:</label>
    <select name="membershipTier">
        <option value="Standard">Standard</option>
        <option value="Premium">Premium</option>
        <option value="VIP">VIP</option>
    </select>

    <label>Join Date:</label>
    <input type="date" name="joinDate" required>

    <input type="submit" value="Add Client">
</form>

<h2>Update Client</h2>
<form>
    <label>Client to Update:</label>
    <select name="clientID" required>
        <option value="">Select a Client</option>
        <option value="1">1 - Emma Thompson</option>
        <option value="2">2 - Michael Rodriguez</option>
        <option value="3">3 - Sophia Chen</option>
        <option value="4">4 - James Patel</option>
    </select>

    <label>New First Name:</label>
    <input type="text" name="firstName">

    <label>New Last Name:</label>
    <input type="text" name="lastName">

    <label>New Email:</label>
    <input type="email" name="email">

    <label>New Phone:</label>
    <input type="text" name="phone">

    <label>New Membership Tier:</label>
    <select name="membershipTier">
        <option value="">Select Tier</option>
        <option value="Standard">Standard</option>
        <option value="Premium">Premium</option>
        <option value="VIP">VIP</option>
    </select>

    <label>New Join Date:</label>
    <input type="date" name="joinDate">

    <input type="submit" value="Update Client">
</form>
